{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-memory:contract:2.0.0",
  "title": "AI memory 2.0.0",
  "oneOf": [
    {
      "$ref": "#/$defs/ExtractionBatch"
    },
    {
      "$ref": "#/$defs/SummaryBatch"
    },
    {
      "$ref": "#/$defs/MemoryRecord"
    }
  ],
  "$defs": {
    "SourceRef": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "message_id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Quote": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "message_id",
        "source_revision",
        "quote"
      ],
      "additionalProperties": false
    },
    "LocatedEvidence": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "start_codepoint": {
          "type": "integer",
          "minimum": 0
        },
        "end_codepoint": {
          "type": "integer",
          "minimum": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "message_id",
        "source_revision",
        "quote",
        "start_codepoint",
        "end_codepoint",
        "source_sha256"
      ],
      "additionalProperties": false
    },
    "Envelope": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "extract",
            "summary"
          ]
        },
        "base_scope_revision": {
          "type": "integer",
          "minimum": 0
        },
        "base_deletion_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "base_working_summary_version": {
          "type": "integer",
          "minimum": 0
        },
        "persona_revision": {
          "type": "integer",
          "minimum": 1
        },
        "import_generation": {
          "type": "integer",
          "minimum": 1
        },
        "policy_version": {
          "const": "2.0.6"
        },
        "config_version": {
          "const": "2.0.6"
        },
        "prompt_version": {
          "enum": [
            "extract-2.0.3",
            "extract-2.0.4",
            "extract-2.0.5",
            "extract-2.0.6",
            "summary-2.0.3"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "new_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "target_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "maxProperties": 20
        },
        "created_at": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "scope_id",
        "session_id",
        "job_id",
        "kind",
        "base_scope_revision",
        "base_deletion_epoch",
        "base_working_summary_version",
        "persona_revision",
        "import_generation",
        "policy_version",
        "config_version",
        "prompt_version",
        "sources",
        "new_source_ids",
        "target_versions",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Temporal": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "local_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "precision": {
          "enum": [
            "instant",
            "date",
            "unknown"
          ]
        },
        "original": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "occurred_at",
        "local_date",
        "timezone",
        "precision",
        "original"
      ],
      "additionalProperties": false
    },
    "Candidate": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation": {
          "enum": [
            "ADD",
            "CORROBORATE",
            "SUPERSEDE",
            "CONTRADICT",
            "RELATE",
            "RETRACT",
            "NOOP"
          ]
        },
        "relation_type": {
          "anyOf": [
            {
              "enum": [
                "SUPPORTS",
                "ELABORATES"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "viewpoint_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "value": {},
        "epistemic": {
          "enum": [
            "declared",
            "observed",
            "inferred"
          ]
        },
        "reason": {
          "enum": [
            "durable_preference",
            "confirmed_commitment",
            "important_experience",
            "attributed_impression",
            "recent_event"
          ]
        },
        "target_memory_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "temporal": {
          "$ref": "#/$defs/Temporal"
        },
        "commitment_state": {
          "anyOf": [
            {
              "enum": [
                "proposed",
                "active",
                "overdue_unknown",
                "completed",
                "cancelled"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "importance_hint": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "candidate_id",
        "operation",
        "relation_type",
        "subject_id",
        "viewpoint_id",
        "predicate",
        "text",
        "value",
        "epistemic",
        "reason",
        "target_memory_id",
        "expected_version",
        "temporal",
        "commitment_state",
        "importance_hint",
        "evidence"
      ],
      "additionalProperties": false
    },
    "WorkingItem": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "additionalProperties": false
    },
    "WorkingSummary": {
      "type": "object",
      "properties": {
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkingItem"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkingItem"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkingItem"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkingItem"
          },
          "minItems": 0,
          "maxItems": 8
        }
      },
      "required": [
        "goals",
        "constraints",
        "unresolved",
        "references"
      ],
      "additionalProperties": false
    },
    "ExtractionBatch": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "ExtractionBatch"
        },
        "envelope": {
          "$ref": "#/$defs/Envelope"
        },
        "processed_message_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "contract",
        "envelope",
        "processed_message_ids",
        "candidates"
      ],
      "additionalProperties": false
    },
    "SummaryBatch": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SummaryBatch"
        },
        "envelope": {
          "$ref": "#/$defs/Envelope"
        },
        "processed_message_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "working_summary": {
          "$ref": "#/$defs/WorkingSummary"
        }
      },
      "required": [
        "contract",
        "envelope",
        "processed_message_ids",
        "events",
        "working_summary"
      ],
      "additionalProperties": false
    },
    "MemoryRecord": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "MemoryRecord"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "tier": {
          "enum": [
            "A0",
            "A1",
            "A2"
          ]
        },
        "fact_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "viewpoint_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "value": {},
        "epistemic": {
          "enum": [
            "configured",
            "declared",
            "observed",
            "inferred"
          ]
        },
        "lifecycle": {
          "enum": [
            "active",
            "needs_review"
          ]
        },
        "temporal": {
          "$ref": "#/$defs/Temporal"
        },
        "commitment_state": {
          "anyOf": [
            {
              "enum": [
                "proposed",
                "active",
                "overdue_unknown",
                "completed",
                "cancelled"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "pinned": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocatedEvidence"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "deletion_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "source_anchor": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "contract",
        "schema_version",
        "scope_id",
        "memory_id",
        "version",
        "tier",
        "fact_key",
        "subject_id",
        "viewpoint_id",
        "predicate",
        "text",
        "value",
        "epistemic",
        "lifecycle",
        "temporal",
        "commitment_state",
        "pinned",
        "evidence",
        "deletion_epoch",
        "expires_at",
        "source_anchor"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "tier": {
                "const": "A2"
              }
            }
          },
          "then": {
            "properties": {
              "expires_at": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "expires_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
