<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WxBotProbe" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/ui_primary</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.WxBotProbe.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ui_primary</item>
        <item name="android:windowBackground">@drawable/ui_dialog_background</item>
        <item name="android:windowNoTitle">false</item>
    </style>
</resources>
